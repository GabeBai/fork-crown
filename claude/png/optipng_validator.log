int
osys_fgetsize(FILE *stream, osys_fsize_t *size)
{
    osys_foffset_t offset;
    if (osys_fseeko(stream, 0, 2) != 0)
        return -1;
    offset = osys_ftello(stream);
    if (offset < 0)
        return -1;
    *size = (osys_fsize_t)offset;
    return 0;
}


