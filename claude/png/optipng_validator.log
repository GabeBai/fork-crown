        } else if libc::strncmp(b"dir\0".as_ptr() as *const c_char, opt.as_ptr(), opt_len) == 0 {
            if !options.dir_name.is_null() {
                error(b"Multiple output dir names are not permitted\0".as_ptr() as *const c_char);
            }
            if *xopt as u8 == 0 {
