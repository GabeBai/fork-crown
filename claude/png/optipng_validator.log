fn opng_store_image_info(png_ptr: *mut png_struct, info_ptr: *mut png_info, store_meta: bool) {
    assert!(image.row_pointers.is_some(), "No info in image");

    unsafe {
        png_set_IHDR(
            png_ptr,
            info_ptr,
            image.width,
            image.height,
            image.bit_depth,
            image.color_type,
            image.interlace_type,
            image.compression_type,
            image.filter_type,
        );

        png_set_rows(write_ptr, write_info_ptr, image.row_pointers.unwrap());

        if let Some(palette) = image.palette {
            png_set_PLTE(png_ptr, info_ptr, palette, image.num_palette);
        }

        if image.trans_alpha.is_some() || image.trans_color_ptr.is_some() {
            png_set_tRNS(
                png_ptr,
