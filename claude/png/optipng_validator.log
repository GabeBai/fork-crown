            options.fix = 1;
        } else if libc::strncmp(b"force\0".as_ptr() as *const c_char, opt.as_ptr(), opt_len) == 0 && opt_len >= 2 {
            options.force = 1;
        } else if libc::strncmp(b"full\0".as_ptr() as *const c_char, opt.as_ptr(), opt_len) == 0 && opt_len >= 2 {
            options.full = 1;
        } else if libc::strcmp(b"nb\0".as_ptr() as *const c_char, opt.as_ptr()) == 0 {
            options.nb = 1;
        } else if libc::strcmp(b"nc\0".as_ptr() as *const c_char, opt.as_ptr()) == 0 {
            options.nc = 1;
        } else if libc::strcmp(b"np\0".as_ptr() as *const c_char, opt.as_ptr()) == 0 {
            options.np = 1;
        } else if libc::strcmp(b"nx\0".as_ptr() as *const c_char, opt.as_ptr()) == 0 {
            options.nb = 1;
            options.nc = 1;
