char*
scan_part(char* start, enum Category category, char delimiter1, char delimiter2) {
  char* p = start;
  for(;;)
  {
    if( *p=='\0' || *p==delimiter1 || *p==delimiter2)
       return p;
    if(char_cat[ (unsigned char) *p ] & category) {
      ++p;
    }else{
      return ((void*)0);
    }
  }
}
