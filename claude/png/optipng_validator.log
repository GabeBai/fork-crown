fn osys_copy_attr(src_path: &str, dest_path: &str) -> std::io::Result<()> {
    let metadata = fs::metadata(src_path)?;
    
    // Set owner and group
    let uid = metadata.uid();
    let gid = metadata.gid();
    nix::unistd::chown(dest_path, Some(nix::unistd::Uid::from_raw(uid)), Some(nix::unistd::Gid::from_raw(gid)))?;

    // Set permissions
    let mode = metadata.mode();
    fs::set_permissions(dest_path, fs::Permissions::from_mode(mode))?;

    // Set access and modification times
    let atime = SystemTime::from(metadata.accessed()?);
    let mtime = SystemTime::from(metadata.modified()?);
    filetime::set_file_times(dest_path, atime, mtime)?;

    Ok(())
