            png_set_hIST(png_ptr, info_ptr, hist);
        }

        if let Some(sig_bit_ptr) = image.sig_bit_ptr {
            png_set_sBIT(png_ptr, info_ptr, sig_bit_ptr);
        }

        if image.num_unknowns != 0 {
