            if options.window_bits == 0 {
                options.window_bits = val;
            } else if options.window_bits != val {
                error(b"Multiple window sizes are not permitted\0".as_ptr() as *const c_char);
            }
        } else if libc::strncmp(b"strip\0".as_ptr() as *const c_char, opt.as_ptr(), opt_len) == 0 && opt_len >= 2 {
