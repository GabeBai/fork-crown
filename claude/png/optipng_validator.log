fn osys_copy_attr(src_path: &str, dest_path: &str) -> std::io::Result<()> {
    let metadata = fs::metadata(src_path)?;
    
    // Copy ownership
    let _ = fs::chown(dest_path, Some(metadata.uid()), Some(metadata.gid()));

    // Copy permissions
    fs::set_permissions(dest_path, metadata.permissions())?;

    // Copy timestamps
    let atime = SystemTime::from(metadata.accessed()?);
    let mtime = SystemTime::from(metadata.modified()?);
    let times = [atime, mtime];
    File::open(dest_path)?.set_times(times[0], times[1])?;

