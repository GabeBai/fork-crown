            || (opt[0] as c_char == b'z' as c_char && (*__ctype_b_loc()).offset(opt[1] as isize).read() & CharacterClass::Alpha as u16 != 0 && (*__ctype_b_loc()).offset(opt[2] as isize).read() & CharacterClass::Digit as u16 != 0)
        {
