pub extern "C" fn url_get_hostname(url: *const libc::c_char) -> *mut libc::c_char {
    unsafe {
        let data = url_parse(url);
        let out = if !data.is_null() && !(*data).host.is_null() {
            libc::strdup((*data).host)
        } else {
            ptr::null_mut()
        };
        url_free(data);
        out
    }
}
