osys_fwrite_at(FILE *stream, osys_foffset_t offset, int whence,
               const void *block, size_t blocksize)
{
    fpos_t pos;
    size_t result;
    if (fgetpos(stream, &pos) != 0 || fflush(stream) != 0)
        return 0;
    if (osys_fseeko(stream, offset, whence) == 0)
